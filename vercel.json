{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/cron/merchant-notifications",
      "destination": "/api/cron/merchant-notifications.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
