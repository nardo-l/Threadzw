{
  "rewrites": [
    {
      "source": "/shop/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/((?!_next|api|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/shop/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
